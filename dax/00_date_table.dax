// ============================================================================
// Dim_Date  (Day 3)
// Modeling > New table > paste everything below the comment lines.
// Then: Table tools > Mark as date table > choose [Date].
// Sort "Month" by "Month No" and "Year Month" by "Year Month Sort".
// ============================================================================
Dim_Date =
VAR MinDate = DATE ( YEAR ( MIN ( Fact_Orders[OrderDate] ) ), 1, 1 )
VAR MaxDate = DATE ( YEAR ( MAX ( Fact_Orders[OrderDate] ) ), 12, 31 )
RETURN
    ADDCOLUMNS (
        CALENDAR ( MinDate, MaxDate ),
        "Year", YEAR ( [Date] ),
        "Quarter", "Q" & QUARTER ( [Date] ),
        "Year Quarter", YEAR ( [Date] ) & " Q" & QUARTER ( [Date] ),
        "Month No", MONTH ( [Date] ),
        "Month", FORMAT ( [Date], "MMM" ),
        "Year Month", FORMAT ( [Date], "YYYY-MM" ),
        "Year Month Sort", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
        "Weekday No", WEEKDAY ( [Date], 2 ),
        "Weekday", FORMAT ( [Date], "ddd" ),
        "Is Weekend", IF ( WEEKDAY ( [Date], 2 ) > 5, "Weekend", "Weekday" )
    )
