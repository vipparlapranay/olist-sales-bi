// ============================================================================
// DAX measures
//
// Naming: these match the tables written by the Python pipeline to
// outputs/model/ and loaded straight into Power BI — lowercase table names
// (fact_sales, dim_date) and lowercase snake_case columns (is_late,
// review_score). Don't rename the queries on import; the names line up as-is.
//
// Create each one in the _Measures table: right-click _Measures > New measure
// > paste. Use New MEASURE, not New table or New column.
// Display folders follow the section headers below
// (Model view > Properties > Display folder).
// Format strings are listed in docs/04_kpi_dictionary.md.
//
// Why a "valid sale" filter? Cancelled and unavailable orders aren't real
// sales. The flag is computed once in the pipeline (is_valid_sale /
// is_valid_order), so every measure applies the same rule.
// ============================================================================


// ---------------------------------------------------------------- 1. Sales
Revenue =
CALCULATE ( SUM ( fact_sales[price] ), fact_sales[is_valid_sale] = 1 )

Freight =
CALCULATE ( SUM ( fact_sales[freight_value] ), fact_sales[is_valid_sale] = 1 )

Gross Order Value =
[Revenue] + [Freight]

Orders =
CALCULATE ( DISTINCTCOUNT ( fact_sales[order_id] ), fact_sales[is_valid_sale] = 1 )

Items Sold =
CALCULATE ( COUNTROWS ( fact_sales ), fact_sales[is_valid_sale] = 1 )

AOV =
DIVIDE ( [Revenue], [Orders] )

Items per Order =
DIVIDE ( [Items Sold], [Orders] )

// customer_id is regenerated per order, so real customers = distinct
// customer_unique_id. FILTER over the fact table limits the dimension to
// customers who actually have a valid sale.
Customers =
CALCULATE (
    DISTINCTCOUNT ( dim_customer[customer_unique_id] ),
    FILTER ( fact_sales, fact_sales[is_valid_sale] = 1 )
)

Active Sellers =
CALCULATE ( DISTINCTCOUNT ( fact_sales[seller_id] ), fact_sales[is_valid_sale] = 1 )


// ---------------------------------------------------------- 2. Time intelligence
// These only work correctly once dim_date is marked as a date table
// (Table tools > Mark as date table > date).
Revenue PY =
CALCULATE ( [Revenue], SAMEPERIODLASTYEAR ( dim_date[date] ) )

Revenue YoY =
IF ( NOT ISBLANK ( [Revenue PY] ), [Revenue] - [Revenue PY] )

Revenue YoY % =
DIVIDE ( [Revenue YoY], [Revenue PY] )

Revenue MTD =
TOTALMTD ( [Revenue], dim_date[date] )

Revenue YTD =
TOTALYTD ( [Revenue], dim_date[date] )

Revenue Rolling 3M =
CALCULATE (
    [Revenue],
    DATESINPERIOD ( dim_date[date], MAX ( dim_date[date] ), -3, MONTH )
)

Revenue 3M Monthly Avg =
DIVIDE ( [Revenue Rolling 3M], 3 )

Orders PY =
CALCULATE ( [Orders], SAMEPERIODLASTYEAR ( dim_date[date] ) )

Orders YoY % =
DIVIDE ( [Orders] - [Orders PY], [Orders PY] )

// The data stops in August 2018, so a calendar-year comparison puts 12 months
// against 8 and understates growth badly. This compares the same months of
// each year, which is the honest read.
Revenue YoY % (Like for Like) =
VAR LastMonthWithData =
    CALCULATE ( MAX ( dim_date[month_no] ), ALL ( dim_date ), [Revenue] > 0 )
VAR CY =
    CALCULATE ( [Revenue], dim_date[month_no] <= LastMonthWithData )
VAR PY =
    CALCULATE (
        [Revenue],
        SAMEPERIODLASTYEAR ( dim_date[date] ),
        dim_date[month_no] <= LastMonthWithData
    )
RETURN
    DIVIDE ( CY - PY, PY )


// ------------------------------------------------------------ 3. Product ranking
// ALLSELECTED respects slicers (a region filter, say) but ignores the row's own
// category, so ranks read as "within what the user has selected".
Category Rank =
IF (
    HASONEVALUE ( dim_product[category] ),
    RANKX ( ALLSELECTED ( dim_product[category] ), [Revenue], , DESC, DENSE )
)

// Bottom ranking: only categories that actually sold, otherwise blanks rank first.
Category Rank Ascending =
IF (
    HASONEVALUE ( dim_product[category] ) && [Revenue] > 0,
    RANKX (
        FILTER ( ALLSELECTED ( dim_product[category] ), [Revenue] > 0 ),
        [Revenue], , ASC, DENSE
    )
)

// Use as a visual-level filter: "Is Top 10 Category is 1"
Is Top 10 Category =
IF ( [Category Rank] <= 10, 1, 0 )

Is Bottom 10 Category =
IF ( NOT ISBLANK ( [Category Rank Ascending] ) && [Category Rank Ascending] <= 10, 1, 0 )

Revenue Share % =
DIVIDE ( [Revenue], CALCULATE ( [Revenue], ALLSELECTED ( dim_product[category] ) ) )

// Pareto: running share of revenue from the biggest category down to this one.
Cumulative Share % =
VAR CurrentRevenue = [Revenue]
VAR AllCategories = ALLSELECTED ( dim_product[category] )
VAR RunningTotal =
    SUMX ( FILTER ( AllCategories, [Revenue] >= CurrentRevenue ), [Revenue] )
RETURN
    IF ( NOT ISBLANK ( CurrentRevenue ),
        DIVIDE ( RunningTotal, CALCULATE ( [Revenue], AllCategories ) ) )

// Item-level average review, so it can be sliced by category. Deliberately
// different from [Avg Review Score], which is per order — explain the
// difference if asked.
Avg Review by Item =
CALCULATE ( AVERAGE ( fact_sales[review_score] ), fact_sales[is_valid_sale] = 1 )


// ------------------------------------------------------------------ 4. Delivery
Delivered Orders =
CALCULATE ( COUNTROWS ( fact_orders ), fact_orders[is_delivered] = 1 )

Late Orders =
CALCULATE ( COUNTROWS ( fact_orders ), fact_orders[is_late] = 1 )

Late Delivery % =
DIVIDE ( [Late Orders], [Delivered Orders] )

On-Time Delivery % =
IF ( NOT ISBLANK ( [Delivered Orders] ), 1 - [Late Delivery %] )

Avg Delivery Days =
CALCULATE ( AVERAGE ( fact_orders[delivery_days] ), fact_orders[is_delivered] = 1 )

Avg Days vs Estimate =
CALCULATE ( AVERAGE ( fact_orders[days_vs_estimate] ), fact_orders[is_delivered] = 1 )


// ------------------------------------------------------------ 5. Customer experience
Reviewed Orders =
CALCULATE ( COUNTROWS ( fact_orders ), NOT ISBLANK ( fact_orders[review_score] ) )

Avg Review Score =
AVERAGE ( fact_orders[review_score] )

% 5-Star =
DIVIDE ( CALCULATE ( COUNTROWS ( fact_orders ), fact_orders[review_score] = 5 ), [Reviewed Orders] )

% Detractors =
DIVIDE ( CALCULATE ( COUNTROWS ( fact_orders ), fact_orders[review_score] <= 2 ), [Reviewed Orders] )

Avg Review (Late) =
CALCULATE ( [Avg Review Score], fact_orders[is_late] = 1 )

Avg Review (On Time) =
CALCULATE ( [Avg Review Score], fact_orders[is_delivered] = 1, fact_orders[is_late] = 0 )

Review Gap (On Time - Late) =
[Avg Review (On Time)] - [Avg Review (Late)]

// The headline claim on the delivery page. Plot it by Delivery Status rather
// than plotting raw counts: on-time orders outnumber late ones 14 to 1, so a
// count chart shows a taller on-time bar at every score and contradicts the
// finding. This is a rate, and it reads 54.2% against 6.8%.
One Star Rate =
DIVIDE (
    CALCULATE ( COUNTROWS ( fact_orders ), fact_orders[review_score] = 1 ),
    [Reviewed Orders]
)


// ---------------------------------------------------------------- 6. Payments
Payment Value =
CALCULATE ( SUM ( fact_orders[payment_value] ), fact_orders[is_valid_order] = 1 )

Avg Instalments =
CALCULATE ( AVERAGE ( fact_orders[max_installments] ), fact_orders[is_valid_order] = 1 )


// -------------------------------------------------------- 7. ABC and segments
// These surface pipeline output that the first version of the report never
// showed: the ABC classification and the RFM segments.
Class A Revenue =
CALCULATE ( [Revenue], dim_category_abc[abc_class] = "A" )

Class A Share =
DIVIDE ( [Class A Revenue], CALCULATE ( [Revenue], ALL ( dim_category_abc ) ) )

Segment Customers =
DISTINCTCOUNT ( dim_customer_segment[customer_unique_id] )

Segment Value =
SUM ( dim_customer_segment[monetary] )

Avg Segment Value =
DIVIDE ( [Segment Value], [Segment Customers] )

Repeat Customer Rate =
DIVIDE (
    CALCULATE (
        DISTINCTCOUNT ( dim_customer_segment[customer_unique_id] ),
        dim_customer_segment[frequency] > 1
    ),
    DISTINCTCOUNT ( dim_customer_segment[customer_unique_id] )
)

At Risk Value =
CALCULATE ( [Segment Value], dim_customer_segment[segment] = "At Risk (high value)" )


// ---------------------------------------------------- 8. Late-delivery risk model
Avg Late Risk =
AVERAGE ( fact_order_risk[late_risk] )

High Risk Orders =
CALCULATE (
    COUNTROWS ( fact_order_risk ),
    fact_order_risk[risk_band] IN { "High", "Very High" }
)

// Plot this by risk_band. If the bars climb left to right, the model is
// separating real risk — that one chart validates it visually, which is worth
// more in an interview than quoting a PR-AUC.
Actual Late Rate =
DIVIDE (
    CALCULATE ( COUNTROWS ( fact_order_risk ), fact_order_risk[is_late_actual] = 1 ),
    COUNTROWS ( fact_order_risk )
)


// ------------------------------------------- 9. Dynamic titles for the single page
// These read the field parameters created in Modeling > New parameter.
// Apply via: select the visual > Format > General > Title > fx > Field value.
Selected Metric Label =
SELECTEDVALUE ( 'Metric'[Metric], "Revenue" )

Selected Dimension Label =
SELECTEDVALUE ( 'View By'[View By], "Month" )

Selected Period Label =
VAR MinD = MIN ( dim_date[date] )
VAR MaxD = MAX ( dim_date[date] )
RETURN FORMAT ( MinD, "mmm yyyy" ) & " - " & FORMAT ( MaxD, "mmm yyyy" )

Main Chart Title =
[Selected Metric Label] & " by " & [Selected Dimension Label] & ", " & [Selected Period Label]

Revenue Trend Title =
"Revenue trend, " & [Selected Period Label]

Revenue Trend Arrow =
VAR Change = [Revenue YoY % (Like for Like)]
RETURN
    SWITCH (
        TRUE (),
        ISBLANK ( Change ), "",
        Change > 0.02,  "^ " & FORMAT ( Change, "0.0%" ),
        Change < -0.02, "v " & FORMAT ( Change, "0.0%" ),
        "- " & FORMAT ( Change, "0.0%" )
    )

// Use on a card: Format > Callout value > fx > Field value.
Revenue Trend Colour =
SWITCH (
    TRUE (),
    [Revenue YoY % (Like for Like)] > 0,  "#2E8C6E",
    [Revenue YoY % (Like for Like)] < 0,  "#B8465A",
    "#5C7080"
)


// ---------------------------------------------------------- 10. Dynamic commentary
// One card at the foot of the page. It rewrites itself as filters change, so
// the written insight never goes stale against the numbers beside it.
// Card > Format > Callout value > word wrap ON, size ~12pt.
Commentary =
VAR TopCategory =
    CALCULATE (
        FIRSTNONBLANK ( dim_product[category], 1 ),
        TOPN ( 1, ALLSELECTED ( dim_product[category] ), [Revenue], DESC )
    )
VAR TopShare =
    DIVIDE (
        CALCULATE ( [Revenue], dim_product[category] = TopCategory ),
        CALCULATE ( [Revenue], ALLSELECTED ( dim_product[category] ) )
    )
VAR Gap = [Review Gap (On Time - Late)]
RETURN
    "Across " & FORMAT ( [Orders], "#,0" ) & " orders worth "
        & FORMAT ( [Revenue], "R$#,0,,.00M" ) & ", " & TopCategory
        & " leads at " & FORMAT ( TopShare, "0.0%" ) & " of revenue. "
        & "Late deliveries score " & FORMAT ( Gap, "0.00" )
        & " stars below on-time ones."


// ============================================================================
// Calculated COLUMN, not a measure.
// Select fact_orders > Table tools > New column.
// Replaces the unreadable 0/1 legend on the review distribution chart.
// ============================================================================
Delivery Status = IF ( fact_orders[is_late] = 1, "Late", "On time" )
